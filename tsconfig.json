{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["chrome", "vite/client", "node"],
    "noEmit": true
  },
  "include": ["src", "manifest.config.ts", "vite.config.ts", "vite.test.config.ts"]
}
